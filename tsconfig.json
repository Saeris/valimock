{
  "extends": "@saeris/configs/tsconfig",
  "include": ["./**/*.{j,t}s?(x)", "./**/*.spec.ts"],
  "exclude": ["node_modules", ".yarn", ".claude", "**/dist/**"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "customConditions": ["development"],
    "importHelpers": true,
    "types": ["node", "vitest/globals"]
  }
}
